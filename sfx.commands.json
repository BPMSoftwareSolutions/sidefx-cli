        "description": "Show bound mechanics and provider candidates"
      },
      "compare": {
        "min": 2,
        "max": 2,
        "identity": "capability",
        "status": "MISSING",
        "missing": {
          "need": "an estate comparison operation, or a representation operation whose results sfx can diff without capsule knowledge"
        },
        "description": "Structurally compare two capabilities"
      },
      "author": {
        "min": 1,
