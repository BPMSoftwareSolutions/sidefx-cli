{
  "mappingType": "sfx-command-mapping.v1",
  "note": "sfx owns the developer-facing vocabulary (docs/intent.md). The estate owns every operation behind it. Each command either wraps a declared estate operation or is recorded MISSING with what the estate must offer. Nothing here describes capsule layout, plan formats, provider inventory, or authoring language.",
  "surfaces": {
    "capsule-estate-cli": {
      "capabilityId": "deliver-capsule-estate-cli",
      "request": "capsule-estate-cli-delivery-request.v2",
      "rootRefField": "repositoryRootRef",
      "disposableParentRootRefField": "disposableParentRootRef",
      "operations": [
        "verify",
        "resolve",
        "list",
        "inspect",
        "invoke",
        "expand",
        "project",
        "test",
        "direct",
        "prove-direct-execution",
        "proof",
        "sterile-proof"
      ]
    },
    "capability-change-cli": {
      "capabilityId": "deliver-capability-change-cli",
      "request": "capability-change-operation-request.v1",
      "operations": [
        "open",
        "seal",
        "publish",
        "status"
      ]
    },
    "token-provisioning-cli": {
      "capabilityId": "deliver-capability-token-provisioning-cli",
      "operations": [
        "provision"
      ]
    }
  },
  "identities": {
    "capability": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "message": "Use an exact capability identity."
    },
    "provider": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "message": "Use the exact provider identity declared by the estate."
    },
    "execution": {
      "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "message": "Use a retained execution identity."
    }
  },
  "commands": {
    "estate": {
      "verify": {
        "min": 0,
        "max": 0,
        "wraps": {
          "surface": "capsule-estate-cli",
          "operation": "verify"
        },
        "description": "Verify estate integrity and layout"
      },
      "inspect": {
        "min": 0,
        "max": 0,
        "wraps": {
          "surface": "capsule-estate-cli",
          "operation": "verify"
        },
