        "max": null,
        "query": true,
        "wraps": {
          "surface": "capsule-estate-cli",
          "operation": "list",
          "fields": {
            "query": "$query"
          }
        },
        "description": "Search estate capabilities by required query"
      },
      "inspect": {
        "min": 1,
        "max": 1,
        "identity": "capability",
        "wraps": {
          "surface": "capsule-estate-cli",
          "operation": "inspect",
          "fields": {
            "capabilityId": "$subject"
          }
        },
        "description": "Inspect one capability"
      },
      "resolve": {
        "min": 1,
        "max": 1,
        "identity": "capability",
        "wraps": {
          "surface": "capsule-estate-cli",
          "operation": "resolve",
          "fields": {
            "capabilityId": "$subject"
          }
        },
        "description": "Resolve the declared dependency closure"
      },
      "invoke": {
        "min": 1,
        "max": 1,
        "identity": "capability",
        "input": true,
        "wraps": {
          "surface": "capsule-estate-cli",
          "operation": "invoke",
          "fields": {
            "capabilityId": "$subject",
            "capabilityInput": "$input"
          }
        },
        "description": "Invoke a capability with canonical input"
      },
      "evaluate": {
        "min": 1,
        "max": 1,
        "identity": "capability",
        "wraps": {
          "surface": "capsule-estate-cli",
          "operation": "direct",
          "fields": {
            "capabilityIds": [
              "$subject"
            ]
          }
        },
        "description": "Prove direct execution against admitted fixtures"
      },
      "scenarios": {
        "min": 1,
        "max": 1,
        "identity": "capability",
        "status": "MISSING",
        "missing": {
          "need": "an estate operation returning declared scenario identities for one capability",
          "todaySfxDoes": "decodes the capsule plan and Gherkin itself in src/projection.mjs"
        },
        "description": "List declared scenarios"
      },
      "reveal": {
        "min": 1,
        "max": 1,
        "identity": "capability",
        "view": true,
        "status": "MISSING",
        "missing": {
          "need": "an estate representation operation returning scenario, blueprint, feature and contract views",
          "todaySfxDoes": "decodes capability.authority.json, blueprint.authority.json, plan cells and @scenario/@input/@event/@outcome tags in src/projection.mjs"
        },
        "description": "Reveal scenario, blueprint, feature or contract views"
      },
      "providers": {
        "min": 1,
        "max": 1,
        "identity": "capability",
        "status": "MISSING",
        "missing": {
          "need": "an estate operation returning bound mechanics and eligible providers for one capability",
          "todaySfxDoes": "reads realizationOverlay/mechanicBindings out of the capsule plan"
