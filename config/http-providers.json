{
  "configurationType": "sfx-http-provider-config.v1",
  "timeoutMs": 12000,
  "maxResponseBytes": 1048576,
  "providers": {
    "rapidapi/realty-us": {
      "defaultOperation": "agent-listings",
      "operations": {
        "agent-listings": {
          "method": "GET",
          "origin": "https://realty-us.p.rapidapi.com",
          "path": "/agents/v2/listings",
          "headers": {
            "Content-Type": "application/json",
            "X-RapidAPI-Host": "realty-us.p.rapidapi.com"
          },
          "credential": {
            "kind": "environment",
            "name": "RAPID_API_KEY",
            "scope": "user",
            "header": "X-RapidAPI-Key"
          },
          "parameters": {
            "fulfillmentId": {
              "default": "3155600",
              "pattern": "^[0-9]{1,20}$"
            }
          },
          "expectedStatus": [
            200
          ],
          "responseChecks": []
        }
      }
    },
    "rapidapi/yahoo-finance15": {
      "defaultOperation": "market-news",
      "operations": {
        "market-news": {
          "method": "GET",
          "origin": "https://yahoo-finance15.p.rapidapi.com",
          "path": "/api/v1/markets/news",
          "headers": {
            "Content-Type": "application/json",
            "X-RapidAPI-Host": "yahoo-finance15.p.rapidapi.com"
          },
          "credential": {
            "kind": "environment",
            "name": "RAPID_API_KEY",
            "scope": "user",
            "header": "X-RapidAPI-Key"
          },
          "parameters": {
            "ticker": {
              "default": "AAPL,TSLA",
              "pattern": "^[A-Za-z0-9.^=,-]{1,200}$"
            }
          },
          "expectedStatus": [
            200
          ],
          "responseChecks": []
        }
      }
    },
    "rapidapi/yahoo-finance166": {
      "defaultOperation": "news-list",
      "operations": {
        "news-list": {
          "method": "GET",
          "origin": "https://yahoo-finance166.p.rapidapi.com",
          "path": "/api/news/list",
          "headers": {
            "Content-Type": "application/json",
            "X-RapidAPI-Host": "yahoo-finance166.p.rapidapi.com"
          },
          "credential": {
            "kind": "environment",
            "name": "RAPID_API_KEY",
            "scope": "user",
            "header": "X-RapidAPI-Key"
          },
          "parameters": {
            "snippetCount": {
              "default": "500",
              "pattern": "^[0-9]{1,3}$"
            },
            "region": {
              "default": "US",
              "enum": [
                "US"
              ]
            }
          },
          "expectedStatus": [
            200
          ],
          "responseChecks": []
        },
        "stock-price": {
          "method": "GET",
          "origin": "https://yahoo-finance166.p.rapidapi.com",
          "path": "/api/stock/get-price",
          "headers": {
            "X-RapidAPI-Host": "yahoo-finance166.p.rapidapi.com"
          },
          "credential": {
            "kind": "environment",
            "name": "RAPID_API_KEY",
            "scope": "user",
            "header": "X-RapidAPI-Key"
          },
          "parameters": {
            "region": {
              "default": "US",
              "enum": [
                "US"
              ]
            },
            "symbol": {
              "default": "AAPL",
              "pattern": "^[A-Za-z0-9.^=-]{1,24}$"
            }
          },
          "expectedStatus": [
            200
          ],
          "responseChecks": [
            {
              "pointer": "/quoteSummary/result/0/price/symbol",
              "type": "string",
              "equalsParameter": "symbol"
            },
            {
              "pointer": "/quoteSummary/result/0/price/currency",
              "type": "string"
            },
            {
              "pointer": "/quoteSummary/result/0/price/regularMarketPrice/raw",
              "type": "number"
            }
          ]
        }
      }
    },
    "rapidapi/yahoo-finance-real-time1": {
      "defaultOperation": "stock-options",
      "operations": {
        "stock-options": {
          "method": "GET",
          "origin": "https://yahoo-finance-real-time1.p.rapidapi.com",
          "path": "/stock/get-options",
          "headers": {
            "Content-Type": "application/json",
            "X-RapidAPI-Host": "yahoo-finance-real-time1.p.rapidapi.com"
          },
          "credential": {
            "kind": "environment",
            "name": "RAPID_API_KEY",
            "scope": "user",
            "header": "X-RapidAPI-Key"
          },
          "parameters": {
            "symbol": {
              "default": "WOOF",
              "pattern": "^[A-Za-z0-9.^=-]{1,24}$"
            },
            "lang": {
              "default": "en-US",
              "pattern": "^[a-z]{2}-[A-Z]{2}$"
            },
            "region": {
              "default": "US",
              "enum": [
                "US"
              ]
            }
          },
          "expectedStatus": [
            200
          ],
          "responseChecks": []
        }
      }
    }
  }
}
